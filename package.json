{
  "name": "contextcrate-ui",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i src/main/frontend/contextcrate.css -o target/classes/static/css/contextcrate.css --minify",
    "build:js": "esbuild src/main/frontend/contextcrate.js --bundle --minify --format=iife --outfile=target/classes/static/js/contextcrate.js",
    "watch:css": "tailwindcss -i src/main/frontend/contextcrate.css -o target/classes/static/css/contextcrate.css --watch",
    "watch:js": "esbuild src/main/frontend/contextcrate.js --bundle --format=iife --outfile=target/classes/static/js/contextcrate.js --watch"
  },
  "dependencies": {
    "alpinejs": "3.14.9",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "esbuild": "0.25.12",
    "tailwindcss": "4.1.18"
  }
}
